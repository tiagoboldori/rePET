[Unit]
Description=API central do rePET (POST /replay, /api/replays, /clips, /quadra)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/replay-system/replay-system.env
WorkingDirectory=/opt/replay-system
ExecStart=/opt/replay-system/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
User=replay
Group=replay

[Install]
WantedBy=multi-user.target
