# /etc/replay-system/replay-system.env — modelo do env compartilhado pelos
# units (EnvironmentFile=). Equivale ao .env do start.sh, com caminhos de
# produção. Cada câmera tem o seu em /etc/replay-system/cameras/<quadra_id>.env.
#
# Não commitar a versão real, só este .example.

BUFFER_ROOT=/var/replay
OUTPUT_DIR=/var/replay/output
CAMERAS_FILE=/etc/replay-system/cameras.json
DATABASE_URL=sqlite:////var/replay/repet.db
SEGMENT_TIME=2
OVERLAY_CACHE_DIR=/var/replay/overlays

# --- Integração com a plataforma externa (mantenha replay-lara-worker.service
# desabilitado até preencher estes dois) -------------------------------------
LARA_BASE_URL=https://lara.clube.example/api/replay
REPLAY_API_TOKEN=1|troque-por-um-token-gerado-com-php-artisan-replay:token

# --- Autenticação dos endpoints de gerenciamento (DELETE /api/replays/*) --
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Painel web (/painel): login com ADMIN_USERNAME/ADMIN_PASSWORD, acima --------
# Sessão em cookie assinado; trocar a senha ou o segredo desloga todo mundo.
# PANEL_SESSION_HOURS=12
# PANEL_SECRET=

# --- Live no YouTube: direta (/live) e com placar (/broadcast) -------------------
# Token (Authorization: Bearer; o legado X-Live-Key também vale) das rotas /live, /broadcast e
# /status. O REPLAY_API_TOKEN e as chaves de API_TOKENS (nome:token,nome2:token2; uma por integração)
# também são aceitos como Bearer; sem nenhum deles: 503. A stream key de
# cada quadra fica em `youtube_stream_key` no cameras.json (repetir a mesma key em várias
# quadras é permitido, mas só uma pode estar no ar por vez).
# LIVE_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# LIVE_MAX_SECONDS=7200
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Domínios aceitos por PUT /quadras/{id}/youtube como rtmp_url de uma quadra (separados por vírgula).
# RTMP_ALLOWED_HOSTS=youtube.com
# LIVE_STATE_FILE=/var/replay/live_state.json
# LIVE_MONITOR_INTERVAL_SECONDS=15
# Transmissão com placar: ~1 núcleo por transmissão (ultrafast). Em produção, mantenha estado e
# overlay fora do repositório e lembre que o reboot/restart do serviço derruba o ffmpeg.
# BROADCAST_MAX_CONCURRENT=2
# BROADCAST_PRESET=ultrafast
# BROADCAST_BITRATE=4500k
# BROADCAST_THREADS=4
# BROADCAST_VOLUME_STEP=10
# BROADCAST_VOLUME_MAX=400
# BROADCAST_DIR=/var/replay/broadcast
# BROADCAST_STATE_FILE=/var/replay/broadcast_state.json
# BROADCAST_LOG_DIR=/var/log/replay-system

# --- Ajustes finos opcionais (defaults documentados no README) ------------
# CLIP_DURATION_SECONDS=35
# TRIGGER_COOLDOWN_SECONDS=15
# LARA_POLL_INTERVAL_SECONDS=120
# LARA_HEARTBEAT_INTERVAL_SECONDS=120
# LARA_UPLOAD_POLL_INTERVAL_SECONDS=10
# LOCAL_RAW_RETENTION_DAYS=3
# SAFETY_MARGIN=0.5
# CLIP_WAIT_TIMEOUT_SECONDS=6
# MAX_STALENESS_SECONDS=13
