# /etc/replay-system/replay-system.env — modelo do env compartilhado pelos
# units (EnvironmentFile=). Equivale ao .env do start.sh, com caminhos de
# produção. Cada câmera tem o seu em /etc/replay-system/cameras/<quadra_id>.env.
#
# Não commitar a versão real, só este .example.

BUFFER_ROOT=/var/replay
OUTPUT_DIR=/var/replay/output
CAMERAS_FILE=/etc/replay-system/cameras.json
DATABASE_URL=sqlite:////var/replay/repet.db
SEGMENT_TIME=2
OVERLAY_CACHE_DIR=/var/replay/overlays

# --- Integração com a plataforma externa (mantenha replay-lara-worker.service
# desabilitado até preencher estes dois) -------------------------------------
LARA_BASE_URL=https://lara.clube.example/api/replay
REPLAY_API_TOKEN=1|troque-por-um-token-gerado-com-php-artisan-replay:token

# --- Autenticação dos endpoints de gerenciamento (DELETE /api/replays/*) --
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Ajustes finos opcionais (defaults documentados no README) ------------
# CLIP_DURATION_SECONDS=35
# TRIGGER_COOLDOWN_SECONDS=15
# LARA_POLL_INTERVAL_SECONDS=120
# LARA_HEARTBEAT_INTERVAL_SECONDS=120
# LARA_UPLOAD_POLL_INTERVAL_SECONDS=10
# LOCAL_RAW_RETENTION_DAYS=3
