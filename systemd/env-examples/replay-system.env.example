# /etc/replay-system/replay-system.env — modelo do arquivo compartilhado
# pelos units replay-api/replay-buffer-cleanup/replay-local-retention/
# replay-lara-worker (EnvironmentFile=). Cada câmera continua tendo seu
# próprio env em /etc/replay-system/cameras/<quadra_id>.env, ver
# systemd/env-examples/loc1-quadra3.env — este arquivo aqui é o
# equivalente de produção do `.env` usado por ./start.sh em dev (mesmas
# chaves, valores de caminho real em vez de .data/ dentro do repo).
#
# Nunca commitar a versão real deste arquivo — só este .example.

BUFFER_ROOT=/var/replay
OUTPUT_DIR=/var/replay/output
CAMERAS_FILE=/etc/replay-system/cameras.json
DATABASE_URL=sqlite:////var/replay/repet.db
SEGMENT_TIME=2
OVERLAY_CACHE_DIR=/var/replay/overlays

# --- Integração com o Lara (deixe replay-lara-worker.service desabilitado
# até preencher e testar estes dois) --------------------------------------
LARA_BASE_URL=https://lara.clube.example/api/replay
REPLAY_API_TOKEN=1|troque-por-um-token-gerado-com-php-artisan-replay:token

# --- Autenticação da superfície de gerenciamento (DELETE /api/replays/*) --
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Ajustes finos opcionais (defaults documentados no README) ------------
# CLIP_DURATION_SECONDS=35
# TRIGGER_COOLDOWN_SECONDS=15
# LARA_POLL_INTERVAL_SECONDS=120
# LARA_HEARTBEAT_INTERVAL_SECONDS=120
# LARA_UPLOAD_POLL_INTERVAL_SECONDS=10
# LOCAL_RAW_RETENTION_DAYS=3
