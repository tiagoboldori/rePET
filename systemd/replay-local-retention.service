[Unit]
Description=Retenção local dos clipes finais do rePET
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/replay-system/replay-system.env
WorkingDirectory=/opt/replay-system
ExecStart=/opt/replay-system/.venv/bin/python -m scripts.local_retention_loop
Restart=always
RestartSec=5
User=replay
Group=replay

[Install]
WantedBy=multi-user.target
