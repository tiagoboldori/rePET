# .env.example — modelo de configuração local: `cp .env.example .env`,
# preencher e rodar `./start.sh`. O .env real é gitignored; não commitar
# credencial.
#
# BUFFER_ROOT, OUTPUT_DIR, CAMERAS_FILE, DATABASE_URL e SEGMENT_TIME não
# vão aqui: o start.sh (e o boot.sh do serviço) fixam esses valores em .data/
# e sobrescrevem o que vier daqui.
#
# Quando o .env é lido: o serviço (scripts/boot.sh) o carrega na subida, ou seja,
# no reboot diário das 06:00 ou em `systemctl restart repet`. Variável NOVA (que o
# watchdog ainda não tinha) também vale ao reiniciar só a API (`kill $(cat run/api.pid)`);
# mudar o VALOR de uma que já existia exige reiniciar o serviço ou esperar o reboot.
# Variável já exportada no ambiente tem prioridade sobre o .env.
#
# Atenção: o .env não aceita comentário na mesma linha do valor (ex.:
# `LIVE_MAX_SECONDS=14400   # 4h` derruba a API com ValueError). Comente
# sempre em linha própria.

# --- Integração com a plataforma externa ----------------------------------
# Sem os dois abaixo, o worker de integração não sobe. O REPLAY_API_TOKEN também é
# aceito como Bearer nas rotas /live, /broadcast e /status (veja LIVE_API_KEY).
# LARA_BASE_URL=https://lara.clube.example/api/replay
# REPLAY_API_TOKEN=1|troque-por-um-token-gerado-com-php-artisan-replay:token

# --- FTP do clube: destino dos clipes (o Lara só recebe o caminho) --------
# Sem FTP_HOST/FTP_USER/FTP_PASSWORD o worker de integração não sobe.
# Estrutura: <FTP_BASE_DIR>/<quadra_id>/<AAAA-MM-DD>/<HHh00>/<id do clipe>.mp4
# FTP_HOST=192.168.0.10
# FTP_PORT=21
# FTP_USER=usuario-ftp
# FTP_PASSWORD=troque-pela-senha-do-ftp
# FTP_BASE_DIR=Lara/Repet
# FTP_TIMEOUT_SECONDS=60

# --- Administrador: DELETE /api/replays/* e login do painel web (/painel) --
# Sem os dois abaixo, o DELETE responde 401 a tudo e o login do painel responde 503.
# Use uma senha longa: com este usuário o painel liga e desliga transmissões e o
# DELETE apaga replays. O painel trafega em HTTP puro (só na rede interna).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=troque-por-uma-senha-forte
# Sessão do painel (cookie assinado): validade em horas e segredo extra opcional
# (trocar a senha ou o segredo desloga todo mundo).
# PANEL_SESSION_HOURS=12
# PANEL_SECRET=

# --- Live no YouTube: direta (/live) e com placar (/broadcast) -------------
# Token das rotas de controle (/live, /broadcast, /status), enviado em
# `Authorization: Bearer <token>` (o header legado X-Live-Key também vale). O mesmo
# token vale para todas as câmeras; o painel usa a sessão em vez dele. Essas rotas
# também aceitam como Bearer o REPLAY_API_TOKEN (o token do Lara, abaixo) e as chaves de
# API_TOKENS (abaixo): basta um deles configurado; sem nenhum, respondem 503. A stream key de
# cada quadra vai em `youtube_stream_key` no config/cameras.json; repetir a MESMA
# key em várias quadras é permitido, mas só uma pode estar no ar por vez.
# LIVE_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# Chaves nomeadas, uma por integração (revogue apagando o par). Formato: nome:token,nome2:token2.
# Gere com: python3 -c "import secrets; print('repet_live_' + secrets.token_urlsafe(32))"
# API_TOKENS=painel-web:repet_live_troque-por-um-token-gerado
# Prazo de qualquer live (direta ou com placar); 0 = sem limite.
# LIVE_MAX_SECONDS=7200
# Ingest do YouTube.
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
# Domínios (e subdomínios) aceitos por `PUT /quadras/{id}/youtube` como `rtmp_url` de uma quadra, além do
# host da YOUTUBE_RTMP_URL. Separe por vírgula; IP só vale por inteiro. Reinicie a API para valer.
# RTMP_ALLOWED_HOSTS=youtube.com
# Prazos das lives diretas ligadas (reassumidos quando a API sobe).
# LIVE_STATE_FILE=.data/live_state.json
# De quanto em quanto tempo a API pergunta às câmeras se a live direta está ligada.
# LIVE_MONITOR_INTERVAL_SECONDS=15

# --- Transmissão com placar (/broadcast): o servidor reencoda ---------------
# Custo medido: ~1 núcleo por transmissão em ultrafast (~1,5 em veryfast).
# Transmissões simultâneas (a regra da key compartilhada se soma a este limite).
# BROADCAST_MAX_CONCURRENT=2
# Preset x264, bitrate (sempre em "<n>k") e núcleos por transmissão.
# BROADCAST_PRESET=ultrafast
# BROADCAST_BITRATE=4500k
# BROADCAST_THREADS=4
# Volume ao vivo: passo do up/down e teto, em % do volume da câmera.
# BROADCAST_VOLUME_STEP=10
# BROADCAST_VOLUME_MAX=400
# Redução de ruído do áudio da transmissão com placar (a live direta sai da câmera e não é afetada):
# off | leve | medio | forte. Padrão: medio (~+1% de um núcleo por transmissão). Vale quando a
# transmissão é iniciada ou relançada, não numa que já está no ar.
# AUDIO_DENOISE=medio
# Fonte do placar.
# BROADCAST_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Overlay/FIFO por quadra, estado (placar, volume, pid, prazo) e logs do ffmpeg.
# BROADCAST_DIR=.data/broadcast
# BROADCAST_STATE_FILE=.data/broadcast_state.json
# BROADCAST_LOG_DIR=logs

# --- Ajustes finos opcionais (defaults documentados no README) ------------
# CLIP_DURATION_SECONDS=35
# TRIGGER_COOLDOWN_SECONDS=15
# Corte no instante do botão: margem para considerar um segmento fechado, quanto o
# corte espera o segmento do clique fechar (precisa ser maior que o intervalo entre
# keyframes da câmera) e a idade máxima do último segmento (mais velho: o corte falha).
# SAFETY_MARGIN=0.5
# CLIP_WAIT_TIMEOUT_SECONDS=6
# MAX_STALENESS_SECONDS=13
# LARA_POLL_INTERVAL_SECONDS=120
# LARA_HEARTBEAT_INTERVAL_SECONDS=120
# LARA_UPLOAD_POLL_INTERVAL_SECONDS=10
# LOCAL_RAW_RETENTION_DAYS=3

# --- Música de fundo (assets/music/, ver assets/music/README.md) ----------
# MUSIC_DIR=assets/music
# MUSIC_VOLUME=0.4
# MUSIC_FADE_SECONDS=1.5
# Som ambiente (áudio da câmera) por baixo da música; 0 = só a música.
# AMBIENT_VOLUME=0.4
