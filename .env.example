# .env.example — modelo de configuração local: `cp .env.example .env`,
# preencher e rodar `./start.sh`. O .env real é gitignored; não commitar
# credencial.
#
# BUFFER_ROOT, OUTPUT_DIR, CAMERAS_FILE, DATABASE_URL e SEGMENT_TIME não
# vão aqui: o start.sh fixa esses valores em .data/ e sobrescreve o que
# vier daqui.

# --- Integração com a plataforma externa ----------------------------------
# Sem os dois abaixo, o worker de integração não sobe.
# LARA_BASE_URL=https://lara.clube.example/api/replay
# REPLAY_API_TOKEN=1|troque-por-um-token-gerado-com-php-artisan-replay:token

# --- FTP do clube: destino dos clipes (o Lara só recebe o caminho) --------
# Sem FTP_HOST/FTP_USER/FTP_PASSWORD o worker de integração não sobe.
# Estrutura: <FTP_BASE_DIR>/<quadra_id>/<AAAA-MM-DD>/<HHh00>/<id do clipe>.mp4
# FTP_HOST=192.168.0.10
# FTP_PORT=21
# FTP_USER=usuario-ftp
# FTP_PASSWORD=troque-pela-senha-do-ftp
# FTP_BASE_DIR=Lara/Repet
# FTP_TIMEOUT_SECONDS=60

# --- Autenticação dos endpoints de gerenciamento (DELETE /api/replays/*) --
# Sem os dois abaixo, o endpoint responde 401 a tudo.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=troque-por-uma-senha-forte

# --- Live no YouTube (POST/DELETE /live/{quadra_id}) ----------------------
# Chave única, enviada no header X-Live-Key, vale para todas as câmeras.
# Sem ela o endpoint responde 503. A stream key de cada quadra vai em
# `youtube_stream_key` no config/cameras.json.
# LIVE_API_KEY=troque-por-uma-chave-longa-e-aleatoria
# A API desliga a live na câmera depois desse tempo; 0 = sem limite.
# LIVE_MAX_SECONDS=7200
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# --- Ajustes finos opcionais (defaults documentados no README) ------------
# CLIP_DURATION_SECONDS=35
# TRIGGER_COOLDOWN_SECONDS=15
# LARA_POLL_INTERVAL_SECONDS=120
# LARA_HEARTBEAT_INTERVAL_SECONDS=120
# LARA_UPLOAD_POLL_INTERVAL_SECONDS=10
# LOCAL_RAW_RETENTION_DAYS=3

# --- Música de fundo (assets/music/, ver assets/music/README.md) ----------
# MUSIC_DIR=assets/music
# MUSIC_VOLUME=0.4
# MUSIC_FADE_SECONDS=1.5
# Som ambiente (áudio da câmera) por baixo da música; 0 = só a música.
# AMBIENT_VOLUME=0.4

# Atenção: o .env não aceita comentário na mesma linha do valor (ex.:
# `LIVE_MAX_SECONDS=14400   # 4h` derruba a API com ValueError). Comente
# sempre em linha própria.
